# ------------------------------
# Dependencies and package managers
# ------------------------------
**/node_modules/
**/.pnp
**/.pnp.*
**/.pnpm-store/
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# ------------------------------
# Build outputs (all sample apps)
# ------------------------------
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.next/
**/out-tsc/
**/tmp/
**/bazel-out/
**/.angular/cache/

# ------------------------------
# Caches and test artifacts
# ------------------------------
**/.sass-cache/
**/coverage/
**/.nyc_output/
**/test-results/
**/playwright-report/
**/cypress/videos/
**/cypress/screenshots/
**/.cache/

# ------------------------------
# Runtime logs and debug files
# ------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/libpeerconnection.log
**/connect.lock
**/testem.log

# ------------------------------
# Environment and local config
# ------------------------------
**/.env
**/.env.*
**/*.local
!**/.env.example

# ------------------------------
# TypeScript and framework metadata
# ------------------------------
**/*.tsbuildinfo
**/next-env.d.ts

# ------------------------------
# IDE and editor files
# ------------------------------
.idea/
**/.idea/
**/.history/
**/.project
**/.classpath
**/.settings/
**/.c9/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code: ignore generated folders, keep settings if committed
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# ------------------------------
# OS/system files
# ------------------------------
**/.DS_Store
**/Thumbs.db

# ------------------------------
# Local SDK binaries/packages (do not commit customer-specific drops)
# ------------------------------
**/*.tgz
**/*.pem

# ------------------------------
# Template Files
# ------------------------------
Repository-README
SampleApp-README.md